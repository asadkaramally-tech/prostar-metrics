# App-owned Azure PostgreSQL serving store.
AZURE_POSTGRES_CONNECTION_STRING=
AZURE_POSTGRES_MIGRATION_CONNECTION_STRING=
POSTGRES_SSL_REJECT_UNAUTHORIZED=
POSTGRES_SSL_CA_CERT=
POSTGRES_SSL_CA_CERT_BASE64=
AZURE_POSTGRES_CA_CERT=
AZURE_POSTGRES_CA_CERT_PATH=
PGSSLROOTCERT=
POSTGRES_POOL_MAX=
POSTGRES_POOL_IDLE_TIMEOUT_MS=
POSTGRES_CONNECTION_TIMEOUT_MS=

# Simpro ingestion workers.
SIMPRO_BASE_URL=
SIMPRO_COMPANY_ID=
SIMPRO_BEARER_TOKEN=
SIMPRO_REQUESTS_PER_SECOND=
SIMPRO_REQUEST_TIMEOUT_MS=
SIMPRO_MAX_PAGE_SIZE=

# Azure identity and commission export storage.
AZURE_CLIENT_ID=
AZURE_STORAGE_ACCOUNT_NAME=
COMMISSION_EXPORT_CONTAINER=

# Azure Easy Auth / Entra authorization.
METRICS_AUTH_MODE=
METRICS_ADMIN_EMAILS=
METRICS_FINANCE_EMAILS=
METRICS_OPERATOR_EMAILS=
METRICS_VIEWER_EMAILS=

# Local development only. Never enable the bypass in production.
METRICS_DEV_AUTH_BYPASS=

# Trusted release workstation.
AZURE_CONFIG_DIR=
MIGRATION_COMPATIBILITY_COMMAND_TIMEOUT_MS=
MIGRATION_COMPATIBILITY_QUERY_TIMEOUT_MS=
MIGRATION_COMPATIBILITY_PLATFORM=
