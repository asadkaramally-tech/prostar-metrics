# App-owned Azure PostgreSQL serving store.
AZURE_POSTGRES_CONNECTION_STRING=postgresql://user:password@host:5432/prostar_metrics
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_SSL_CA_CERT_BASE64=

# Simpro ingestion. Never expose this token to browser code.
SIMPRO_BASE_URL=https://prostarmechanical.simprosuite.com/api/v1.0
SIMPRO_COMPANY_ID=0
SIMPRO_BEARER_TOKEN=
SIMPRO_REQUESTS_PER_SECOND=5
SIMPRO_REQUEST_TIMEOUT_MS=60000

# Azure Easy Auth / Entra role mapping.
METRICS_ADMIN_EMAILS=
METRICS_FINANCE_EMAILS=
METRICS_OPERATOR_EMAILS=
METRICS_VIEWER_EMAILS=

# Local development only. Do not enable in production.
METRICS_DEV_AUTH_BYPASS=false
